{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saintessengine.local/schema/tlog.schema.json",
  "title": "结构化流水声明（tlogs）—— 框架模板，kind 与字段由内容侧定义",
  "$defs": {
    "tlog_entry": {
      "type": "object",
      "title": "一个 kind 的声明（KindSpec）",
      "additionalProperties": true,
      "properties": {
        "kind": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z0-9_]+)*$",
          "description": "点分标识（如 battle.hit）。**表形态（{kind: 声明}）里以对象 key 为准**，此处可省略。"
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "description": "该 kind 携带的字段名（读的人按它取；校验/分析依据）"
        },
        "desc": {
          "type": "string",
          "description": "说明（编辑器/文档用）"
        },
        "category": {
          "type": "string",
          "description": "分类（编辑器分组；取值由内容侧定义，框架不设枚举）"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "该 kind 惯用标签（约定，不强制）"
        }
      },
      "examples": [
        {
          "kind": "battle.hit",
          "fields": [
            "subject",
            "dmg",
            "crit"
          ],
          "desc": "一次命中",
          "category": "battle"
        }
      ]
    },
    "tlog_table": {
      "type": "object",
      "title": "流水声明整表：{kind: 声明对象}（也接受 `{kind: [字段…]}` 简写）",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z0-9_]+)*$"
      },
      "additionalProperties": {
        "type": "object",
        "description": "一条 kind 声明（见 $defs/tlog_entry）"
      },
      "examples": [
        {
          "battle.hit": {
            "fields": [
              "subject",
              "dmg",
              "crit"
            ],
            "category": "battle"
          },
          "quest.accept": {
            "fields": [
              "quest"
            ],
            "category": "quest"
          }
        }
      ]
    }
  },
  "x-primary": "tlog_entry"
}
