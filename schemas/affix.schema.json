{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dragonfall.local/schema/affix.schema.json",
  "title": "Dragonfall 词条（affixes.py）",
  "$defs": {
    "affix": {
      "type": "object",
      "title": "词条（AFFIXES 一条）",
      "required": [
        "name",
        "kind",
        "trigger",
        "effect",
        "desc"
      ],
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "desc": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "attack",
            "defense"
          ]
        },
        "trigger": {
          "enum": [
            "battle_start",
            "on_hit",
            "on_taken",
            "passive",
            "stat",
            "turn_start"
          ]
        },
        "chance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "qualities": {
          "type": "array",
          "items": {
            "enum": [
              "blue",
              "purple",
              "orange"
            ]
          }
        },
        "unique": {
          "type": "boolean"
        },
        "line": {
          "type": "string"
        },
        "effect": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": true
        }
      },
      "examples": [
        {
          "name": "流血",
          "kind": "attack",
          "trigger": "on_hit",
          "chance": 0.2,
          "effect": {
            "dot_pct": 0.05,
            "stacks": 3
          },
          "desc": "攻击 20% 使目标流血(每刻 5% 生命，3 刻)"
        },
        {
          "name": "处决",
          "kind": "attack",
          "trigger": "passive",
          "effect": {
            "dmg_mult": 1.3,
            "execute_threshold": 0.3,
            "tag": "💀处决"
          },
          "desc": "对生命 <30% 的目标＋30% 伤害"
        }
      ]
    },
    "affix_table": {
      "type": "object",
      "title": "AFFIXES 整表：{词条id: 词条}（条目本体见 $defs/affix）",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "object"
      }
    },
    "affix_pool_by_quality": {
      "type": "object",
      "title": "AFFIX_POOL_BY_QUALITY：{品质: [词条id...]}（品质是随机池档位，不是装备品质全集）",
      "minProperties": 1,
      "propertyNames": {
        "enum": [
          "blue",
          "purple",
          "orange"
        ]
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        }
      },
      "examples": [
        {
          "blue": [
            "bleed",
            "armor_break",
            "combo",
            "crit_up"
          ],
          "purple": [
            "execute",
            "lifesteal",
            "crit_dmg"
          ],
          "orange": [
            "element_fire",
            "element_ice"
          ]
        }
      ]
    },
    "affix_kind": {
      "type": "object",
      "title": "AFFIX_KIND：{kind: 中文分组名}",
      "propertyNames": {
        "enum": [
          "attack",
          "defense"
        ]
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      },
      "examples": [
        {
          "attack": "武器",
          "defense": "防具"
        }
      ]
    }
  },
  "x-primary": "affix"
}
