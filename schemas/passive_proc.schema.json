{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saintessengine.local/schema/passive_proc.schema.json",
  "title": "被动声明表（PASSIVE_PROC）—— 框架协议",
  "$defs": {
    "passive_proc": {
      "type": "object",
      "title": "被动声明（PASSIVE_PROC 一条）",
      "description": "两种形态：(a) 事件驱动 {event, action, judge,...}；(b) 域声明 {domain: cap|cost,...}。",
      "minProperties": 1,
      "anyOf": [
        {
          "required": [
            "event",
            "action"
          ],
          "properties": {
            "event": {
              "enum": [
                "act_cast",
                "act_done",
                "attack_hit",
                "dmg_calc",
                "dot_calc",
                "heal_calc",
                "on_death",
                "on_kill",
                "on_taken",
                "skill_hit",
                "taken_calc",
                "time_advance",
                "turn_start"
              ]
            },
            "action": {
              "type": "string",
              "description": "取值由内容侧声明（声明表 / 注册机制）决定；框架不预设。"
            }
          }
        },
        {
          "required": [
            "domain"
          ]
        }
      ],
      "additionalProperties": true,
      "properties": {
        "event": {
          "enum": [
            "act_cast",
            "act_done",
            "attack_hit",
            "dmg_calc",
            "dot_calc",
            "heal_calc",
            "on_death",
            "on_kill",
            "on_taken",
            "skill_hit",
            "taken_calc",
            "time_advance",
            "turn_start"
          ]
        },
        "action": {
          "type": "string",
          "description": "取值由内容侧声明（声明表 / 注册机制）决定；框架不预设。"
        },
        "domain": {
          "enum": [
            "cap",
            "cost"
          ]
        },
        "judge": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": true
        },
        "also": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "event",
              "action"
            ],
            "additionalProperties": true,
            "properties": {
              "event": {
                "enum": [
                  "act_cast",
                  "act_done",
                  "attack_hit",
                  "dmg_calc",
                  "dot_calc",
                  "heal_calc",
                  "on_death",
                  "on_kill",
                  "on_taken",
                  "skill_hit",
                  "taken_calc",
                  "time_advance",
                  "turn_start"
                ]
              },
              "action": {
                "type": "string",
                "description": "取值由内容侧声明（声明表 / 注册机制）决定；框架不预设。"
              }
            }
          }
        },
        "when": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "buff_key": {
          "type": "string"
        },
        "cap_key": {
          "type": "string"
        },
        "used_key": {
          "type": "string"
        },
        "left_key": {
          "type": "string"
        },
        "cost_field": {
          "type": "string"
        },
        "gain_field": {
          "type": "string"
        },
        "bar_field": {
          "type": "string"
        },
        "mech_prefix": {
          "type": "string"
        },
        "res": {
          "type": "string"
        },
        "agg": {
          "type": "string"
        },
        "mode": {
          "type": "string"
        },
        "form": {
          "type": "string"
        },
        "left_init": {
          "type": "integer"
        },
        "spd_pct": {
          "type": "number"
        },
        "def_pct": {
          "type": "number"
        },
        "hold": {
          "type": "number"
        },
        "gap": {
          "type": "number"
        },
        "ctrl_any": {
          "type": "boolean"
        }
      },
      "examples": [
        {
          "event": "dmg_calc",
          "action": "example_proc_action",
          "judge": {
            "kind": "mech",
            "mech": "example_mech"
          }
        },
        {
          "domain": "cap",
          "cap_key": "example_cap_key"
        }
      ]
    },
    "passive_proc_table": {
      "type": "object",
      "title": "PASSIVE_PROC 整表：{proc id: 被动声明}（条目本体见 $defs/passive_proc）",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "object"
      }
    }
  },
  "x-primary": "passive_proc"
}
