{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saintessengine.local/schema/skill.schema.json",
  "title": "技能（skills）—— 框架模板，取值语义由内容侧定义",
  "$defs": {
    "skill": {
      "type": "object",
      "title": "技能条目",
      "description": "PLAYER_SKILLS / BRANCH_SKILLS / TUTOR_SKILLS 里的一条技能定义。",
      "required": [
        "name",
        "kind",
        "lv",
        "desc"
      ],
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "desc": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "description": "取值由内容侧声明（声明表 / 注册机制）决定；框架不预设。"
        },
        "lv": {
          "type": "integer",
          "minimum": 1
        },
        "mp": {
          "type": "integer",
          "minimum": 0
        },
        "cd": {
          "type": "integer",
          "minimum": 0
        },
        "power": {
          "type": "number",
          "minimum": 0
        },
        "cast": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "const": "None"
            }
          ]
        },
        "exprs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "formula": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "heal_formula": {
          "type": "string"
        },
        "mech": {
          "type": "string",
          "description": "取值由内容侧声明（声明表 / 注册机制）决定；框架不预设。"
        },
        "mech_val": {
          "type": "number"
        },
        "mech_chance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "mech2": {
          "type": "string",
          "description": "取值由内容侧声明（声明表 / 注册机制）决定；框架不预设。"
        },
        "mech2_val": {
          "type": "number"
        },
        "effect": {
          "type": "string",
          "description": "取值由内容侧声明（声明表 / 注册机制）决定；框架不预设。"
        },
        "buff_turns": {
          "type": "integer",
          "minimum": 0
        },
        "hits": {
          "type": "integer",
          "minimum": 1
        },
        "aoe": {
          "enum": [
            "all",
            "front"
          ]
        },
        "target": {
          "enum": [
            "back"
          ]
        },
        "element": {
          "type": "string",
          "description": "取值由内容侧声明（声明表 / 注册机制）决定；框架不预设。"
        },
        "summon": {
          "type": "string",
          "description": "取值由内容侧声明（声明表 / 注册机制）决定；框架不预设。"
        },
        "team": {
          "type": "string",
          "description": "取值由内容侧声明（声明表 / 注册机制）决定；框架不预设。"
        },
        "pierce": {
          "type": "boolean"
        },
        "no_mp": {
          "type": "boolean"
        },
        "sleep": {
          "type": "boolean"
        },
        "accuracy": {
          "type": "boolean"
        },
        "crit": {
          "type": "boolean"
        },
        "stance": {
          "type": "string",
          "description": "取值由内容侧声明（声明表 / 注册机制）决定；框架不预设。"
        },
        "auto": {
          "type": "string",
          "description": "取值由内容侧声明（声明表 / 注册机制）决定；框架不预设。"
        },
        "kind_override": {
          "type": "string",
          "description": "取值由内容侧声明（声明表 / 注册机制）决定；框架不预设。"
        },
        "hate_mult": {
          "type": "number"
        },
        "hate_taunt_mult": {
          "type": "number"
        },
        "hate_lock_turns": {
          "type": "integer",
          "minimum": 0
        },
        "lifesteal": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "hp_pct": {
          "type": "number"
        },
        "reduce_all": {
          "type": "number"
        },
        "reduce_pct": {
          "type": "number"
        },
        "charge": {
          "type": "number"
        },
        "res_cost": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "type": "string",
            "description": "取值由内容侧声明（声明表 / 注册机制）决定；框架不预设。"
          },
          "additionalProperties": {
            "type": "integer"
          }
        },
        "kill": {
          "type": "object"
        },
        "cond": {
          "type": "object",
          "required": [
            "type"
          ],
          "additionalProperties": true,
          "properties": {
            "type": {
              "type": "string",
              "description": "取值由内容侧声明（声明表 / 注册机制）决定；框架不预设。"
            },
            "mult": {
              "type": "number"
            },
            "stacks": {
              "type": "integer",
              "minimum": 1
            },
            "mech": {
              "type": "string"
            },
            "label": {
              "type": "string"
            }
          }
        },
        "passive": {
          "type": "object",
          "required": [
            "proc"
          ],
          "additionalProperties": true,
          "description": "proc 指向被动处理器 id；须在 saintess_engine PASSIVE_PROC 或 core/passive_procs 注册。",
          "properties": {
            "proc": {
              "type": "string",
              "minLength": 1
            },
            "add": {
              "type": "number"
            },
            "mult": {
              "type": "number"
            },
            "stacks": {
              "type": "integer"
            },
            "per_layer": {
              "type": "number"
            },
            "hp_pct": {
              "type": "number"
            },
            "reduce": {
              "type": "number"
            }
          }
        }
      },
      "examples": [
        {
          "name": "挥砍",
          "kind": "物理",
          "lv": 1,
          "mp": 6,
          "power": 0.82,
          "cast": 0.45,
          "mech": "example_mech",
          "mech_val": 1,
          "exprs": [
            "atk*1 + 20 + player_lv*5.0 + skill_lv*12"
          ],
          "desc": "示例：造成一次攻击（随等级成长），命中时叠加 1 层由内容侧声明的机制标记"
        },
        {
          "name": "淬血",
          "kind": "被动",
          "lv": 50,
          "mp": 0,
          "power": 1.0,
          "cast": "None",
          "passive": {
            "proc": "example_proc",
            "per_layer": 0.015
          },
          "desc": "示例：每层该机制标记额外提供 1.5% 吸血（数值由内容侧声明）"
        }
      ]
    },
    "player_skills": {
      "type": "object",
      "title": "PLAYER_SKILLS：{职业id: {name, skills:{技能id: 技能}}}",
      "propertyNames": {
        "type": "string",
        "description": "取值由内容侧声明（声明表 / 注册机制）决定；框架不预设。"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "name",
          "skills"
        ],
        "additionalProperties": true,
        "properties": {
          "name": {
            "type": "string"
          },
          "skills": {
            "type": "object",
            "additionalProperties": {
              "type": "object"
            }
          }
        }
      }
    },
    "branch_skills": {
      "type": "object",
      "title": "BRANCH_SKILLS：{职业id: {name, branches:{转职阶:{线名:{技能名: 技能}}}}}（技能 key 是中文名，不是 sk_*）",
      "propertyNames": {
        "type": "string",
        "description": "取值由内容侧声明（声明表 / 注册机制）决定；框架不预设。"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "name",
          "branches"
        ],
        "additionalProperties": true,
        "properties": {
          "name": {
            "type": "string"
          },
          "branches": {
            "type": "object",
            "propertyNames": {
              "pattern": "^[0-9]+$"
            },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "tutor_skills": {
      "type": "object",
      "title": "TUTOR_SKILLS：{职业id: {技能id: 技能}}",
      "propertyNames": {
        "type": "string",
        "description": "取值由内容侧声明（声明表 / 注册机制）决定；框架不预设。"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "object"
        }
      }
    }
  },
  "x-primary": "skill"
}
