{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saintessengine.local/schema/text.schema.json",
  "title": "文案模板（texts）—— 框架模板，文案内容与命名由内容侧定义",
  "$defs": {
    "text_entry": {
      "type": "object",
      "title": "一条文案模板（TextSpec）",
      "required": [
        "value"
      ],
      "additionalProperties": true,
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z_][A-Za-z0-9_.]*$",
          "description": "文案标识。**表形态（{key: 声明}）里以对象 key 为准**，此处可省略；仅独立/数组存档形态需要显式写。"
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "description": "模板串，{slot} 为占位符；未知占位符渲染时原样保留"
        },
        "desc": {
          "type": "string",
          "description": "说明（编辑器/帮助用）"
        },
        "category": {
          "type": "string",
          "description": "分类（编辑器分组；取值由内容侧定义）"
        },
        "params": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "声明的占位符名（缺省由模板自动抽取；声明后自检会比对）"
        }
      },
      "examples": [
        {
          "key": "battle.damage_taken",
          "value": "受到 {n} 点伤害",
          "desc": "受击提示",
          "category": "battle",
          "params": [
            "n"
          ]
        }
      ]
    },
    "text_table": {
      "type": "object",
      "title": "文案整表：{key: 声明对象}——编辑器用对象形态；代码装载时也接受 `{key: 模板串}` 简写",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_.]*$"
      },
      "additionalProperties": {
        "type": "object",
        "description": "一条文案声明（见 $defs/text_entry）。编辑器只认对象形态，便于携带 desc/category/params；简写字符串仅供代码装载。"
      },
      "examples": [
        {
          "battle.damage_taken": {
            "value": "受到 {n} 点伤害",
            "desc": "受击提示",
            "category": "battle"
          },
          "ui.button_confirm": {
            "value": "确认",
            "category": "ui"
          }
        }
      ]
    }
  },
  "x-primary": "text_entry"
}
