{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saintessengine.local/schema/item.schema.json",
  "title": "物品（items）—— 框架模板，取值语义由内容侧定义",
  "$defs": {
    "item": {
      "type": "object",
      "title": "物品（ITEMS 一条）",
      "required": [
        "name",
        "price",
        "desc"
      ],
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "desc": {
          "type": "string",
          "minLength": 1
        },
        "price": {
          "type": "number",
          "minimum": 0
        },
        "type": {
          "type": "string",
          "description": "取值由内容侧声明（声明表 / 注册机制）决定；框架不预设。"
        },
        "quality": {
          "enum": [
            "blue",
            "green",
            "orange",
            "purple",
            "white"
          ]
        },
        "effect": {
          "type": "string",
          "description": "取值由内容侧声明（声明表 / 注册机制）决定；框架不预设。"
        },
        "effect_data": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": true
        },
        "food_effect": {
          "type": "string",
          "description": "取值由内容侧声明（声明表 / 注册机制）决定；框架不预设。"
        },
        "heal": {
          "type": "number",
          "minimum": 0
        },
        "mana": {
          "type": "number",
          "minimum": 0
        },
        "hot": {
          "type": "number",
          "minimum": 0
        },
        "hot_turns": {
          "type": "integer",
          "minimum": 0
        },
        "hot_mana": {
          "type": "number",
          "minimum": 0
        },
        "stamina": {
          "type": "integer",
          "minimum": 0
        },
        "cast": {
          "type": "number",
          "minimum": 0
        },
        "food": {
          "type": "boolean"
        },
        "battle_ok": {
          "type": "boolean"
        },
        "key_item": {
          "type": "boolean"
        },
        "blueprint_for": {
          "type": "string",
          "minLength": 1
        },
        "roster_id": {
          "type": "string",
          "pattern": "^eq_[a-z0-9_]+$"
        },
        "learn_skill": {
          "type": "string",
          "minLength": 1
        },
        "require_class": {
          "type": "string",
          "description": "取值由内容侧声明（声明表 / 注册机制）决定；框架不预设。"
        },
        "rune_pool": {
          "type": "string"
        },
        "weapon_pick": {
          "type": "boolean"
        },
        "pick_options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name",
              "rid",
              "desc"
            ],
            "additionalProperties": true,
            "properties": {
              "name": {
                "type": "string"
              },
              "rid": {
                "type": "string"
              },
              "desc": {
                "type": "string"
              }
            }
          }
        }
      },
      "examples": [
        {
          "price": 120,
          "name": "亡影铠甲片",
          "type": "兽材",
          "desc": "百族战将·亡影身上剥落的暗色铠甲残片，铁匠铺与炼金坊都愿意出价收购"
        },
        {
          "price": 110,
          "name": "裂鬃獠牙图纸",
          "type": "图纸",
          "blueprint_for": "裂鬃獠牙",
          "roster_id": "eq_lie_zong_liao_ya",
          "desc": "野猪王·裂鬃的锻造图纸，学习后可锻造【裂鬃獠牙】(Lv.30 匕首)"
        },
        {
          "name": "珍珠明目水",
          "price": 100,
          "effect": "buff_crit_small",
          "desc": "战斗中使用，暴击率 + 15%(3 刻)，湖珍珠磨粉调制的灵水"
        }
      ]
    },
    "item_table": {
      "type": "object",
      "title": "ITEMS 整表：{物品id: 物品}（条目本体见 $defs/item）",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "object"
      }
    }
  },
  "x-primary": "item"
}
