{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "skills",
  "description": "铆炉回声 · 技能域 —— 本包自带 schema（域的真源在包；框架 schemas/ 只是没自带时的回退）",
  "$defs": {
    "skill": {
      "type": "object",
      "required": ["name", "kind", "exprs"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "description": "技能名"},
        "kind": {"type": "string", "minLength": 1,
                 "description": "本游戏的种类词（引擎不认字面量，只拿去 config.kind_of() 比对）"},
        "exprs": {"type": "array", "minItems": 1, "items": {"type": "string"},
                  "description": "伤害表达式（引擎 formulas 求值）"},
        "cd": {"type": "integer", "minimum": 0, "description": "冷却回合数"},
        "res_cost": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0},
                     "description": "资源消耗：{资源 key: 层数}"},
        "hits": {"type": "integer", "minimum": 1, "description": "连击段数"},
        "aoe": {"type": "boolean", "description": "是否群体"},
        "desc": {"type": "string", "description": "说明（编辑器里显示）"}
      },
      "additionalProperties": true
    }
  }
}
