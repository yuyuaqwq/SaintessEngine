{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saintessengine.local/schema/monster.schema.json",
  "title": "怪物（monsters / subareas / instances / hidden_monsters）—— 框架模板",
  "$defs": {
    "monster_skill": {
      "type": "object",
      "title": "怪物技能（MONSTER_SKILLS）",
      "required": [
        "name",
        "kind",
        "desc"
      ],
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "desc": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "description": "取值由内容侧声明（声明表 / 注册机制）决定；框架不预设。"
        },
        "power": {
          "type": "number",
          "minimum": 0
        },
        "formula": {
          "type": "array",
          "title": "结构化公式",
          "x-widget": "rows",
          "description": "招式公式行数组：**一行 = 一段伤害**（stat / mult / type 三键必填）。实测 232 条招式带它，与 power 配合。",
          "items": {
            "type": "object",
            "required": [
              "stat",
              "mult",
              "type"
            ],
            "additionalProperties": true,
            "properties": {
              "stat": {
                "enum": [
                  "atk",
                  "matk"
                ]
              },
              "mult": {
                "type": "number"
              },
              "type": {
                "enum": [
                  "magi",
                  "phys"
                ]
              }
            }
          }
        },
        "element": {
          "type": "string",
          "description": "取值由内容侧声明（声明表 / 注册机制）决定；框架不预设。"
        },
        "effect": {
          "type": "string",
          "description": "取值由内容侧声明（声明表 / 注册机制）决定；框架不预设。"
        },
        "mech": {
          "type": "string",
          "description": "取值由内容侧声明（声明表 / 注册机制）决定；框架不预设。"
        },
        "mech_val": {
          "type": "integer"
        },
        "aoe": {
          "enum": [
            "all"
          ]
        },
        "summon": {
          "type": "integer",
          "minimum": 1
        },
        "charge": {
          "type": "integer",
          "minimum": 1
        },
        "hits": {
          "type": "integer",
          "minimum": 1
        },
        "multi": {
          "type": "integer",
          "minimum": 1
        },
        "hp_pct": {
          "type": "number"
        },
        "defend_reduce": {
          "type": "number"
        },
        "reach": {
          "type": "integer"
        },
        "basic": {
          "type": "boolean"
        },
        "cast": {
          "type": "number",
          "minimum": 0
        },
        "recovery": {
          "type": "number",
          "minimum": 0
        },
        "pdot": {
          "type": "object",
          "title": "周期伤害块",
          "x-widget": "kv",
          "description": "命中后给目标挂的周期伤害（DOT）声明块 —— 结构由内容侧解释（引擎侧 DOT 统一走 EFFECT_RULES.period）。实测 11 条招式带它：type 与 n 每行都有，mult / atk_mult 各自可选。",
          "additionalProperties": true,
          "properties": {
            "type": {
              "type": "string",
              "title": "周期类型",
              "description": "DOT 的类型名（内容侧词汇；实测 corros（腐蚀）/ burn（灼烧）两档）。"
            },
            "n": {
              "type": "integer",
              "title": "叠层数",
              "description": "命中时叠加的层数（实测 1 ~ 2）。"
            },
            "mult": {
              "type": "number",
              "title": "倍率",
              "description": "周期伤害的倍率（实测 0.5 ~ 1.6；缺该键 = 该段不乘 —— 零默认值）。"
            },
            "atk_mult": {
              "type": "number",
              "title": "施法者攻击系数",
              "description": "乘施法者攻击（atk/matk 快照）的系数（实测 0.3 ~ 1.4；缺该键 = 不加成）。"
            }
          }
        }
      },
      "examples": [
        {
          "name": "攻击",
          "kind": "物理",
          "basic": true,
          "formula": [
            {
              "stat": "atk",
              "mult": 1.0,
              "type": "phys"
            }
          ],
          "power": 1.0,
          "cast": 1.0,
          "recovery": 0.0,
          "desc": "普攻，基础物理攻击"
        }
      ]
    },
    "monster_skill_table": {
      "type": "object",
      "title": "MONSTER_SKILLS 整表：{ms_*: 怪物技能}（条目本体见 $defs/monster_skill）",
      "description": "怪物招式表。表键 = **招式 id**：以 `ms_` 开头的稳定 id（实测 330 条全部匹配 pattern；短名如 ms_ha_huan_dan、带批次前缀如 ms_f6_sheng_yu）。编辑器按条目渲染（条目形状见 $defs/monster_skill）。",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$",
        "description": "招式 id（小写字母开头 + 数字/下划线；内容侧惯例是 ms_* 前缀）。"
      },
      "additionalProperties": {
        "type": "object",
        "description": "怪物招式条目 —— 形状见 $defs/monster_skill（编辑器按 x-primary 逐条渲染）。"
      }
    },
    "monster_template": {
      "title": "怪物模板六元组（subareas / instances 的 monsters/elite/boss/minions）",
      "description": "[id, 中文名, role, lv, [怪物技能id...], [掉落物名...]]",
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "prefixItems": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "string",
          "minLength": 1
        },
        {
          "enum": [
            "boss",
            "caster",
            "dps",
            "elite",
            "healer",
            "speedster",
            "tank"
          ]
        },
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ],
      "items": false,
      "examples": [
        [
          "m_slime",
          "绿史莱姆",
          "tank",
          1,
          [
            "ms_zhuang_ji"
          ],
          [
            "史莱姆黏液",
            "史莱姆徽章"
          ]
        ]
      ]
    },
    "hidden_monster": {
      "type": "object",
      "title": "隐藏怪物（HIDDEN_MONSTERS）",
      "required": [
        "id",
        "name",
        "role",
        "lv_off",
        "skills",
        "drops",
        "gold_mult",
        "cond",
        "chance",
        "tag",
        "flavor"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "elite"
          ]
        },
        "lv_off": {
          "type": "integer"
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "drops": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gold_mult": {
          "type": "integer",
          "minimum": 1
        },
        "cond": {
          "type": "string",
          "description": "取值由内容侧声明（声明表 / 注册机制）决定；框架不预设。"
        },
        "chance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "tag": {
          "type": "string"
        },
        "flavor": {
          "type": "string",
          "minLength": 1
        },
        "maps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "examples": [
        {
          "id": "e_gold_slime",
          "name": "黄金史莱姆",
          "role": "elite",
          "lv_off": 2,
          "skills": [
            "ms_du_ya"
          ],
          "drops": [
            "琥珀精华"
          ],
          "gold_mult": 80,
          "cond": "any",
          "chance": 0.004,
          "tag": "✨ 隐藏",
          "flavor": "一只通体金黄的史莱姆，在阳光下闪闪发光！"
        }
      ]
    },
    "elite_equip_drop": {
      "type": "object",
      "title": "精英专属装备掉落表（ELITE_EQUIP_DROP）：{精英中文名: 名册装备id}",
      "additionalProperties": {
        "type": "string",
        "pattern": "^eq_[a-z0-9_]+$"
      },
      "examples": [
        {
          "峡谷巨魔": "eq_ju_mo_liao_ya_zhui"
        }
      ]
    }
  },
  "x-primary": "monster_skill"
}
