{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saintessengine.local/schema/affix.schema.json",
  "title": "词条（affixes）—— 框架模板，取值语义由内容侧定义",
  "$defs": {
    "affix": {
      "type": "object",
      "title": "词条（AFFIXES 一条）",
      "required": [
        "name",
        "kind",
        "trigger",
        "effect",
        "desc"
      ],
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "desc": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "attack",
            "defense"
          ]
        },
        "trigger": {
          "enum": [
            "battle_start",
            "on_hit",
            "on_taken",
            "passive",
            "stat",
            "turn_start"
          ]
        },
        "chance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "qualities": {
          "type": "array",
          "items": {
            "enum": [
              "blue",
              "purple",
              "orange"
            ]
          }
        },
        "unique": {
          "type": "boolean"
        },
        "line": {
          "type": "string"
        },
        "effect": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": true,
          "x-widget": "kv"
        }
      },
      "examples": [
        {
          "name": "流血",
          "kind": "attack",
          "trigger": "on_hit",
          "chance": 0.2,
          "effect": {
            "dot_pct": 0.05,
            "stacks": 3
          },
          "desc": "攻击 20% 使目标流血(每刻 5% 生命，3 刻)"
        },
        {
          "name": "处决",
          "kind": "attack",
          "trigger": "passive",
          "effect": {
            "dmg_mult": 1.3,
            "execute_threshold": 0.3,
            "tag": "💀处决"
          },
          "desc": "对生命 <30% 的目标＋30% 伤害"
        }
      ]
    },
    "affix_table": {
      "type": "object",
      "title": "AFFIXES 整表：{词条id: 词条}（条目本体见 $defs/affix）",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$",
        "description": "键 = 词条 id（装备/名册/词条池都按它引用）。"
      },
      "additionalProperties": {
        "type": "object"
      }
    },
    "affix_pool_by_quality": {
      "type": "object",
      "title": "AFFIX_POOL_BY_QUALITY：{品质: [词条id...]}（品质是随机池档位，不是装备品质全集）",
      "x-widget": "kv",
      "description": "随机词条池：`键 = 品质档位`、`值 = 该档位能随机出的词条 id 表（一行一个）`。**表键空间是随机池档位**（blue/purple/orange 三档），与装备品质全集不是一回事：拿不到档位的品质走兜底档，不是「空池」。",
      "minProperties": 1,
      "propertyNames": {
        "enum": [
          "blue",
          "purple",
          "orange"
        ],
        "description": "键 = 随机池档位（框架侧就是这三档：蓝/紫/橙）。"
      },
      "additionalProperties": {
        "title": "该档位的词条 id 表",
        "type": "array",
        "minItems": 1,
        "x-widget": "lines",
        "description": "该档位可随机出的词条 id（**一行一个**，指向本文件的表键）。武器只出攻击向词条、防具只出防御向词条 —— 那层过滤由内容侧做，池子里可以混放。",
        "items": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        }
      },
      "examples": [
        {
          "blue": [
            "example_affix_a",
            "example_affix_b",
            "example_affix_c",
            "example_affix_d"
          ],
          "purple": [
            "example_affix_e",
            "example_affix_f",
            "example_affix_g"
          ],
          "orange": [
            "example_affix_h",
            "example_affix_i"
          ]
        }
      ]
    },
    "affix_kind": {
      "type": "object",
      "title": "AFFIX_KIND：{kind: 中文分组名}",
      "propertyNames": {
        "enum": [
          "attack",
          "defense"
        ],
        "description": "键 = 词条类别（attack 武器向 / defense 防具向）。"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      },
      "examples": [
        {
          "attack": "武器",
          "defense": "防具"
        }
      ]
    }
  },
  "x-primary": "affix"
}
